# ==============================================================
# SkillSphere — Environment Variables for Docker Compose
# Copy this to .env and fill in real values
# NEVER commit .env to Git — add to .gitignore
# ==============================================================

# ── MongoDB ─────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=skillsphere2024
MONGO_DB=skillsphere

# ── Backend ─────────────────────────────────────────
JWT_SECRET=supersecretjwtkey_CHANGE_THIS_IN_PRODUCTION
BACKEND_PORT=5000
CLIENT_URL=http://localhost:3000

# ── Frontend ────────────────────────────────────────
FRONTEND_PORT=3000
# This gets baked into the React build at build time:
VITE_API_URL=http://localhost:5000/api

# ── Azure Storage (optional — leave empty to use local storage) ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=skillsphere-uploads
