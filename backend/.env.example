# Backend environment variables
# Copy to .env and fill values for development or production

# MongoDB connection
MONGO_URI=mongodb://localhost:27017/skillsphere

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Client URL (frontend) for CORS
CLIENT_URL=http://localhost:5173

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=skillsphere-uploads

# App port
PORT=5000

NODE_ENV=development
